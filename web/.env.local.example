# Supabase (déjà utilisé par web/lib/supabase/server.ts et client.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — clé privilégiée, réservée à web/lib/supabase/service-role.ts
# (webhook Stripe uniquement, après vérification de signature).
# Ne jamais préfixer NEXT_PUBLIC_ — cette clé ne doit jamais être exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — utilisées uniquement côté serveur (web/app/api/webhook/stripe/route.ts)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
