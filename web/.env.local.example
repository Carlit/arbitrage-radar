# Supabase (déjà utilisé par web/lib/supabase/server.ts et client.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — clé privilégiée, réservée à web/lib/supabase/service-role.ts
# (webhook Stripe uniquement, après vérification de signature).
# Ne jamais préfixer NEXT_PUBLIC_ — cette clé ne doit jamais être exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — utilisées uniquement côté serveur (web/app/api/webhook/stripe/route.ts)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe — Price ID réel (price_...) du tier Pro, utilisé par
# web/lib/billing/checkout.ts. stripe_bootstrap_billing.mjs crée les prix par
# lookup_key (arbitrage-radar-pro-monthly) : copier ici l'ID retourné après
# exécution du script, pas de résolution automatique par lookup_key côté web/.
STRIPE_PRICE_PRO_ID=

# Origine absolue de l'app (ex. http://localhost:3000 en dev), utilisée pour
# construire les success_url/cancel_url du Checkout Stripe. Volontairement une
# variable d'env plutôt que dérivée du header Host de la requête (évite de
# construire une URL de redirection de paiement à partir d'un en-tête
# potentiellement falsifiable).
NEXT_PUBLIC_APP_URL=http://localhost:3000
